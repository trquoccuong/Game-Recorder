<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>odx-app</AssemblyName>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray NotifyIcon; WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF text layout needs culture data (XmlLanguage.GetSpecificCulture throws in invariant mode). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Odx.Core/Odx.Core.csproj" />
    <ProjectReference Include="../Odx.Session/Odx.Session.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../games/*.json" Link="games/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Development builds copy odx next to the app, which runs `odx input` and `odx record` as child processes. A
       RID-specific publish (publish.ps1) ships it self-contained in tools/odx/ instead, so it is left out here. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
    <ProjectReference Include="../Odx.Cli/Odx.Cli.csproj" />
  </ItemGroup>
</Project>
