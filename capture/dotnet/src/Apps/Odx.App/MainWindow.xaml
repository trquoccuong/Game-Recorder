<Window x:Class="Odx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Odx Capture" Icon="odx.ico" Width="560" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <!-- Texts come from Strings (English / Vietnamese), set in code-behind. -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="Label">
                <Setter Property="Margin" Value="0,0,8,6" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="6,0,0,6" />
                <Setter Property="Padding" Value="10,2" />
            </Style>
        </Grid.Resources>

        <Label x:Name="LanguageLabel" Grid.Row="0" />
        <ComboBox x:Name="LanguageBox" AutomationProperties.AutomationId="LanguageBox" Grid.Row="0" Grid.Column="1"
                  Margin="0,0,0,6" Width="140" HorizontalAlignment="Left" DisplayMemberPath="Name"
                  SelectionChanged="Language_Changed" />

        <Label x:Name="SourceLabel" Grid.Row="1" />
        <ComboBox x:Name="SourceBox" AutomationProperties.AutomationId="SourceBox" Grid.Row="1" Grid.Column="1"
                  Margin="0,0,0,6" DisplayMemberPath="Label" />
        <Button x:Name="RefreshButton" Grid.Row="1" Grid.Column="2" Click="Refresh_Click" />

        <Label x:Name="GameLabel" Grid.Row="2" />
        <ComboBox x:Name="GameBox" AutomationProperties.AutomationId="GameBox" Grid.Row="2" Grid.Column="1"
                  SelectionChanged="Game_Changed"
                  Margin="0,0,0,6" DisplayMemberPath="Label" />

        <Label x:Name="FpsLabel" Grid.Row="3" />
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
            <ComboBox x:Name="FpsBox" Width="80" />
            <CheckBox x:Name="AudioBox" AutomationProperties.AutomationId="AudioBox" Margin="12,0,0,0"
                      VerticalAlignment="Center" />
        </StackPanel>

        <Label x:Name="ObsLabel" Grid.Row="4" />
        <CheckBox x:Name="ObsBox" AutomationProperties.AutomationId="ObsBox" Grid.Row="4" Grid.Column="1"
                  Margin="0,0,0,6" VerticalAlignment="Center" Checked="Obs_Changed" Unchecked="Obs_Changed" />

        <!-- OBS connection row: shown only while "Record with OBS" is ticked. -->
        <Label x:Name="ObsConnectionLabel" Grid.Row="5" />
        <StackPanel x:Name="ObsConnectionPanel" Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock x:Name="ObsAddressLabel" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="ObsAddressBox" AutomationProperties.AutomationId="ObsAddressBox" Width="120"
                     VerticalContentAlignment="Center" />
            <TextBlock x:Name="ObsPasswordLabel" VerticalAlignment="Center" Margin="12,0,4,0" />
            <PasswordBox x:Name="ObsPasswordBox" AutomationProperties.AutomationId="ObsPasswordBox" Width="100"
                         VerticalContentAlignment="Center" />
        </StackPanel>
        <Button x:Name="ObsTestButton" AutomationProperties.AutomationId="ObsTestButton" Grid.Row="5" Grid.Column="2"
                Click="ObsTest_Click" />

        <!-- Room rows: shown only when odx-capture.json names an orchestrator. -->
        <Label x:Name="PlayerLabel" Grid.Row="6" />
        <TextBox x:Name="PlayerBox" AutomationProperties.AutomationId="PlayerBox" Grid.Row="6" Grid.Column="1" Width="200"
                 HorizontalAlignment="Left" Margin="0,0,0,6" VerticalContentAlignment="Center" />

        <Label x:Name="RoomLabel" Grid.Row="7" />
        <StackPanel x:Name="RoomPanel" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
            <!-- The current room's invite code, selectable so the host can copy it; the code to join is asked in a dialog. -->
            <TextBox x:Name="RoomBox" AutomationProperties.AutomationId="RoomBox" Width="110" IsReadOnly="True"
                     Visibility="Collapsed" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
            <Button x:Name="JoinButton" AutomationProperties.AutomationId="JoinButton" Click="Join_Click" />
            <Button x:Name="CreateButton" AutomationProperties.AutomationId="CreateButton" Click="Create_Click" />
            <CheckBox x:Name="LanBox" AutomationProperties.AutomationId="LanBox" Margin="8,0,0,6" VerticalAlignment="Center" />
        </StackPanel>

        <Label x:Name="HotkeyLabel" Grid.Row="8" />
        <TextBox x:Name="HotkeyBox" AutomationProperties.AutomationId="HotkeyBox" Grid.Row="8" Grid.Column="1"
                 Margin="0,0,0,6" IsReadOnly="True" IsReadOnlyCaretVisible="False" VerticalContentAlignment="Center"
                 GotKeyboardFocus="Hotkey_GotFocus" LostKeyboardFocus="Hotkey_LostFocus"
                 PreviewKeyDown="Hotkey_PreviewKeyDown" />

        <Button x:Name="StartStopButton" AutomationProperties.AutomationId="StartStopButton" Grid.Row="9"
                Grid.ColumnSpan="3" Margin="0,8,0,8" Padding="0,8" FontSize="14" Click="StartStop_Click" />

        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Grid.Row="10"
                   Grid.ColumnSpan="3" TextWrapping="Wrap" />
    </Grid>
</Window>
