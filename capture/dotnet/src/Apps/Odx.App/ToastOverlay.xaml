<Window x:Class="Odx.App.ToastOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Odx Capture notice" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" IsHitTestVisible="False">
    <Border x:Name="Frame" Background="#E0202020" CornerRadius="10" Padding="18,14" Width="420">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Accent" Grid.Column="0" CornerRadius="2" />
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Foreground="#99FFFFFF" FontSize="12" Text="Odx Capture" />
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                <TextBlock x:Name="BodyText" Foreground="#CCFFFFFF" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
