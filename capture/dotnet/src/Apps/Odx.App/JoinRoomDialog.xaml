<Window x:Class="Odx.App.JoinRoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="odx.ico" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=CodeBox}">
    <!-- Texts come from Strings, set by the owner. -->
    <StackPanel Margin="16" MinWidth="260">
        <TextBlock x:Name="Prompt" Margin="0,0,0,8" />
        <TextBox x:Name="CodeBox" AutomationProperties.AutomationId="CodeBox" MaxLength="6" CharacterCasing="Upper"
                 FontFamily="Consolas" FontSize="22" HorizontalContentAlignment="Center" Padding="4"
                 TextChanged="Code_Changed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" AutomationProperties.AutomationId="OkButton" IsDefault="True" IsEnabled="False"
                    MinWidth="80" Padding="10,2" Click="Ok_Click" />
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="80" Padding="10,2" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
