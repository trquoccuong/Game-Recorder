<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>odx-record</AssemblyName>
    <!-- Windows SDK projection gives Windows.Graphics.Capture; buildable (not runnable) on other OSes. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Odx.Core/Odx.Core.csproj" />
  </ItemGroup>
</Project>
