<Window x:Class="Odx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client Capture" Icon="odx.ico" Width="560" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <!-- Texts come from Strings (English / Vietnamese), set in code-behind. -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="Label">
                <Setter Property="Margin" Value="0,0,8,6" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="6,0,0,6" />
                <Setter Property="Padding" Value="10,2" />
            </Style>
        </Grid.Resources>

        <Label x:Name="LanguageLabel" Grid.Row="0" />
        <ComboBox x:Name="LanguageBox" AutomationProperties.AutomationId="LanguageBox" Grid.Row="0" Grid.Column="1"
                  Margin="0,0,0,6" Width="140" HorizontalAlignment="Left" DisplayMemberPath="Name"
                  SelectionChanged="Language_Changed" />

        <Label x:Name="SourceLabel" Grid.Row="1" />
        <ComboBox x:Name="SourceBox" AutomationProperties.AutomationId="SourceBox" Grid.Row="1" Grid.Column="1"
                  Margin="0,0,0,6" DisplayMemberPath="Label" />
        <Button x:Name="RefreshButton" Grid.Row="1" Grid.Column="2" Click="Refresh_Click" />

        <Label x:Name="GameLabel" Grid.Row="2" />
        <ComboBox x:Name="GameBox" AutomationProperties.AutomationId="GameBox" Grid.Row="2" Grid.Column="1"
                  Margin="0,0,0,6" DisplayMemberPath="Label" />

        <Label x:Name="FpsLabel" Grid.Row="3" />
        <ComboBox x:Name="FpsBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Width="80"
                  HorizontalAlignment="Left" />

        <Label x:Name="OutputLabel" Grid.Row="4" />
        <TextBox x:Name="OutputBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" VerticalContentAlignment="Center" />
        <Button x:Name="BrowseButton" Grid.Row="4" Grid.Column="2" Click="Browse_Click" />

        <Label x:Name="NtpLabel" Grid.Row="5" />
        <TextBox x:Name="NtpBox" AutomationProperties.AutomationId="NtpBox" Grid.Row="5" Grid.Column="1"
                 Margin="0,0,0,6" VerticalContentAlignment="Center" />

        <Label x:Name="HotkeyLabel" Grid.Row="6" />
        <TextBox x:Name="HotkeyBox" AutomationProperties.AutomationId="HotkeyBox" Grid.Row="6" Grid.Column="1"
                 Margin="0,0,0,6" IsReadOnly="True" IsReadOnlyCaretVisible="False" VerticalContentAlignment="Center"
                 GotKeyboardFocus="Hotkey_GotFocus" LostKeyboardFocus="Hotkey_LostFocus"
                 PreviewKeyDown="Hotkey_PreviewKeyDown" />

        <Button x:Name="StartStopButton" AutomationProperties.AutomationId="StartStopButton" Grid.Row="7"
                Grid.ColumnSpan="3" Margin="0,8,0,8" Padding="0,8" FontSize="14" Click="StartStop_Click" />

        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Grid.Row="8"
                   Grid.ColumnSpan="3" TextWrapping="Wrap" />
    </Grid>
</Window>
