<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Runs next to the game server: time service, agent hub, game events in, v3 sessions out. Cross-platform. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>odx-orchestrator</AssemblyName>
    <RootNamespace>Odx.Orchestrator</RootNamespace>
    <!-- web.config is for IIS; the orchestrator runs as its own process. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- No static files are served; without this .NET 10 publishes a staticwebassets.endpoints.json manifest. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Odx.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Odx.Session/Odx.Session.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../odx-capture.json" Link="odx-capture.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
</Project>
