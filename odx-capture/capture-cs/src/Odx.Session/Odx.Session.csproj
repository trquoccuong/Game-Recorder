<Project Sdk="Microsoft.NET.Sdk">
  <!-- Session-level operations shared by odx (build, validate), odx-app and the tests: build a spec v2 session from a
       capture folder and validate it (spec v2 §1.5). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Odx.Tests" />
    <InternalsVisibleTo Include="odx-orchestrator" />
    <InternalsVisibleTo Include="odx-merge" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <PackageReference Include="DemoFile.Game.Cs" Version="0.44.1" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Odx.Core/Odx.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../schemas/session_schema.json" LogicalName="session_schema.json" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Multiplayer/capture.proto" GrpcServices="None" />
  </ItemGroup>
</Project>
